<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Server GC matters for this project specifically: B12 measures
         allocation and throughput for directory listing at scenario scale,
         and Workstation GC's smaller heap/different pause behavior would
         skew both numbers relative to what Zara.Engine (which runs Server
         GC — ARCHITECTURE.md §24.2) will actually see in production. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zara.Core\Zara.Core.csproj" />
    <ProjectReference Include="..\..\src\Zara.Filesystem\Zara.Filesystem.csproj" />
    <ProjectReference Include="..\..\src\Zara.Volumes\Zara.Volumes.csproj" />
    <ProjectReference Include="..\..\src\Zara.Storage\Zara.Storage.csproj" />
    <ProjectReference Include="..\..\src\Zara.Indexing\Zara.Indexing.csproj" />
    <ProjectReference Include="..\..\src\Zara.Search\Zara.Search.csproj" />
    <ProjectReference Include="..\..\src\Zara.Ai\Zara.Ai.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

</Project>
