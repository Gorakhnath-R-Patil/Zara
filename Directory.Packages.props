<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.1.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.14.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />

    <!-- Win32 interop (added as milestones need them) -->
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.106" />

    <!-- Storage (added at M2) -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageVersion Include="System.IO.Hashing" Version="9.0.0" />
    <PackageVersion Include="Blake3" Version="2.0.0" />
    <!-- IFileOperation is one of the most notoriously error-prone COM
         interfaces to hand-roll in C# (strict vtable ordering, no type
         library) — a subtle mistake there causes silent memory corruption,
         not a compile error. Vanara.Windows.Shell's ShellFileOperations is a
         well-established, actively maintained wrapper (part of the wider
         Vanara.PInvoke suite already implicitly trusted throughout this
         codebase's interop style) — used here instead of hand-rolled COM
         specifically because the risk profile is qualitatively different
         from the simple flat DllImport signatures elsewhere in Zara.Filesystem. -->
    <PackageVersion Include="Vanara.Windows.Shell" Version="5.0.5" />

    <!-- Logging -->
    <PackageVersion Include="Serilog" Version="4.2.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />

    <!-- IPC (M7): GrpcDotNetNamedPipes rather than full Grpc.AspNetCore +
         Kestrel — a lightweight background process hosting a few RPCs over
         a named pipe has no use for an HTTP server stack; this package
         wraps NamedPipeServerStream/NamedPipeClientStream directly with
         gRPC framing on top, matching ARCHITECTURE.md §6.8's own reasoning
         for choosing gRPC-over-named-pipes over hand-rolled framing (schema-
         first contracts, streaming, cancellation, deadlines) without the
         parts of that stack Zara.Engine doesn't need. -->
    <PackageVersion Include="Grpc.Tools" Version="2.83.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.29.3" />
    <PackageVersion Include="Grpc.Core.Api" Version="2.67.0" />
    <PackageVersion Include="GrpcDotNetNamedPipes" Version="3.1.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
  </ItemGroup>

</Project>
