<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Zara.Core\Zara.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Zara.Security's PolicyEngine needs PathSyntax.IsSameOrDescendant for
         BLOCKED_ROOTS deny-list checks (§17.2) — the same segment-comparison
         logic IPathValidator already uses for allow-list containment, just
         inverted. Exposing the whole (small, stable, already-adversarially-
         tested) internal helper via InternalsVisibleTo avoids either
         duplicating that logic or making it public API surface for everyone. -->
    <InternalsVisibleTo Include="Zara.Security" />
    <InternalsVisibleTo Include="Zara.Security.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="Blake3" />
    <PackageReference Include="Vanara.Windows.Shell" />
  </ItemGroup>

  <!--
    Win32 interop for this project is hand-written (see Interop/NativeMethods.cs)
    rather than generated by CsWin32. The path-resolution surface is small and
    security-sensitive (T05's adversarial suite depends on it behaving exactly
    as written); a handful of reviewed DllImport declarations are easier to
    audit than trusting generated bindings here. Revisit if the Win32 surface
    this project needs grows substantially (e.g. shell/COM interop at M6).
  -->

</Project>
